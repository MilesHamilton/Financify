{
  "expo": {
    "name": "Financify",
    "slug": "financify",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "financify",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1B1B1B",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.mileshamilton.financify",
      "supportsTablet": false,
      "appleTeamId": "CRWZ356NAX",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1B1B1B",
          "imageWidth": 120
        }
      ],
      "./plugins/with-scene-lifecycle.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
