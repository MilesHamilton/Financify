# Auth.js — single-user credentials
AUTH_USERNAME=                    # The one login username (e.g. miles)
AUTH_PASSWORD_HASH=               # argon2id hash: node -e "require('argon2').hash('yourpassword').then(console.log)"
AUTH_SECRET=                      # JWT signing key: openssl rand -base64 32

# Postgres (Neon) — use pooled URL at runtime, direct URL for drizzle-kit migrate
DATABASE_URL=                     # Neon pooled connection string (?pgbouncer=true)
DATABASE_URL_UNPOOLED=            # Neon direct connection string (for migrations)

# Plaid
PLAID_ENV=                        # sandbox | production
PLAID_CLIENT_ID=                  # Plaid team client ID (same across environments)
PLAID_SECRET=                     # Plaid API secret (per-environment: sandbox vs production)
PLAID_TOKEN_ENC_KEY=              # AES-256-GCM key for access_token encryption: openssl rand -base64 32
PLAID_REDIRECT_URI=               # OAuth redirect URI — must match Plaid Dashboard allowlist
PLAID_WEBHOOK_URL=                # Plaid webhook delivery URL (ngrok in local dev)

# Cron
CRON_SECRET=                      # Bearer token for /api/cron/sync — any random string
